    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:functions": "deno test --allow-env --allow-read --no-lock --node-modules-dir=none supabase/functions supabase/tests",
    "test:all": "npm test && npm run test:functions",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
