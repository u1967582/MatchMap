{
  "expo": {
    "name": "MatchMap",
    "slug": "matchmap",
    "version": "1.0.15",
    "scheme": "matchmap",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-web-browser",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MatchMap uses your location to show nearby bars and sports events on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with other users.",
          "cameraPermission": "The app accesses your camera to let you take photos and share them with other users."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "edgeToEdgeEnabled": true
          },
          "ios": {
            "infoPlist": {
              "UIViewControllerBasedStatusBarAppearance": false
            },
            "enableBitcode": false
          }
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ],
      "expo-mail-composer",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.tuorg.matchmap",
      "buildNumber": "10",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "LSApplicationQueriesSchemes": ["googlegmail", "googlemail"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "MatchMap uses your location to show nearby bars and sports events on the map.",
        "NSCameraUsageDescription": "MatchMap needs camera access to let you take photos for your bar profile and posts.",
        "NSPhotoLibraryUsageDescription": "MatchMap needs access to your photo library to let you select images for your bar profile, menus, and posts.",
        "NSPhotoLibraryAddUsageDescription": "MatchMap would like to save photos to your photo library."
      }
    },
    "android": {
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1C2A3A"
      },
      "package": "com.tuorg.matchmap",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "matchmap",
              "host": "*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b00dc031-795d-48e3-b948-828096e7382c"
      }
    },
    "owner": "koala.gost"
  }
}
